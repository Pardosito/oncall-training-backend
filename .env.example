# Runtime
NODE_ENV=development
PORT=3000
WORKER_HEALTH_PORT=3001
LOG_LEVEL=info

# AWS configuration (Local defaults point to LocalStack)
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566

# DynamoDB
SESSIONS_TABLE=Sessions

# S3
FILES_BUCKET=oncall-training-files-local

# SQS
USER_ACTIONS_QUEUE_URL=http://sqs.us-east-1.localhost.localstack.cloud:4566/000000000000/user-actions.fifo

# Orchestration: stepfunctions (default) | direct (Nov 5 MVP, D-24)
ORCHESTRATION_MODE=stepfunctions
# Required when ORCHESTRATION_MODE=direct
FAULTS_QUEUE_URL=http://sqs.us-east-1.localhost.localstack.cloud:4566/000000000000/faults

# Step Functions (required when ORCHESTRATION_MODE=stepfunctions)
STATE_MACHINE_ARN=arn:aws:states:us-east-1:000000000000:stateMachine:oncall-training-session

# Athena
ATHENA_WORKGROUP=oncall-training
ATHENA_DATABASE=oncall_training

# Redis (optional; unset in the Nov 5 MVP)
REDIS_URL=redis://localhost:6379

# Cognito Auth
COGNITO_USER_POOL_ID=us-east-1_localpool
COGNITO_CLIENT_ID=localclientid12345
AUTH_MODE=dev
# true lets AUTH_MODE=dev run outside NODE_ENV=development (Nov 5 MVP only)
ALLOW_DEV_AUTH=false

# Mock Cluster
MOCK_CLUSTER=fake
MOCK_NAMESPACE=mock
MOCK_HEALTH_URL_TEMPLATE=http://{service}.mock.svc.cluster.local:8080/health

# Stats
STATS_MODE=fixture
