{
  "id": "peak-outage",
  "title": "Checkout outage at peak traffic",
  "description": "Hard mode: orders are failing during the busiest hour. No log access, three minutes, and every wrong move costs four times as much.",
  "warmupSeconds": 20,
  "maxResolveSeconds": 180,
  "targets": ["gateway", "orders", "worker-svc"],
  "baseline": { "gateway": 1, "orders": 2, "worker-svc": 1 },
  "faults": [{ "type": "SCALE_TO_ZERO", "target": "worker-svc" }],
  "availableActions": ["ACKNOWLEDGE", "RESTART_DEPLOYMENT", "SCALE_DEPLOYMENT"],
  "validFixes": [{ "type": "SCALE_DEPLOYMENT", "target": "worker-svc", "minReplicas": 1 }],
  "scoring": { "base": 1000, "perSecondTTD": 2, "perSecondTTR": 2, "perWrongAction": 100 }
}
