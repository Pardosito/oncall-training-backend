{
  "id": "storefront-down",
  "title": "The storefront is unreachable",
  "description": "Every request to the shop fails before it reaches a backend service.",
  "warmupSeconds": 20,
  "maxResolveSeconds": 600,
  "targets": ["gateway", "orders", "worker-svc"],
  "baseline": { "gateway": 1, "orders": 2, "worker-svc": 1 },
  "faults": [{ "type": "SCALE_TO_ZERO", "target": "gateway" }],
  "availableActions": ["ACKNOWLEDGE", "VIEW_LOGS", "RESTART_DEPLOYMENT", "SCALE_DEPLOYMENT"],
  "validFixes": [{ "type": "SCALE_DEPLOYMENT", "target": "gateway", "minReplicas": 1 }],
  "scoring": { "base": 1000, "perSecondTTD": 1, "perSecondTTR": 1, "perWrongAction": 25 }
}
