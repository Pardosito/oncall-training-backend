    "securitySchemes": {
      "bearerAuth": {
        "bearerFormat": "JWT",
        "description": "Cognito access token. With AUTH_MODE=dev, send `x-dev-user` instead.",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "Backend of On-Call Training. Generated from the zod schemas (`pnpm openapi`); do not edit by hand.",
    "title": "On-Call Training API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/openapi.json": {
      "get": {
        "responses": {
          "200": {
            "description": "OpenAPI document"
          }
        },
        "summary": "This document",
        "tags": [
          "health"
        ]
      }
    },
    "/api/scenarios": {
      "get": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ScenarioSummary"
                  },
                  "type": "array"
                }
              }
            },
            "description": "Scenario list"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Missing or invalid credentials (`UNAUTHORIZED`)"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Internal error (`INTERNAL`)"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "List scenarios",
        "tags": [
          "scenarios"
        ]
      }
    },
