          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Not found, or not yours (`NOT_FOUND`)"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Internal error (`INTERNAL`)"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Get a scenario (public view, no answer)",
        "tags": [
          "scenarios"
        ]
      }
    },
    "/api/sessions": {
      "post": {
        "description": "Starts the scenario for the caller. Returns 409 `SESSION_BUSY` with `details.retryAfterSeconds` while another session holds the global lock (not enforced in the Nov 5 MVP).",
