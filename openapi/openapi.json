{
  "components": {
    "parameters": {},
    "schemas": {
      "ActionAccepted": {
        "properties": {
          "actionId": {
            "example": "01JBQ4ZJ8V2N7K3M5P6R8S9T0W",
            "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
            "type": "string"
          }
        },
        "required": [
          "actionId"
        ],
        "type": "object"
      },
      "ActionRequest": {
        "oneOf": [
          {
            "properties": {
              "type": {
                "enum": [
                  "ACKNOWLEDGE"
                ],
                "type": "string"
              }
            },
            "required": [
              "type"
            ],
            "type": "object"
          },
          {
            "properties": {
              "target": {
                "example": "orders",
                "minLength": 1,
                "type": "string"
              },
              "type": {
                "enum": [
                  "RESTART_DEPLOYMENT"
                ],
                "type": "string"
              }
            },
            "required": [
              "type",
              "target"
            ],
            "type": "object"
          },
          {
            "properties": {
              "params": {
                "properties": {
                  "replicas": {
                    "maximum": 3,
                    "minimum": 1,
                    "type": "integer"
                  }
                },
                "required": [
                  "replicas"
                ],
                "type": "object"
              },
              "target": {
                "example": "orders",
                "minLength": 1,
                "type": "string"
              },
              "type": {
                "enum": [
                  "SCALE_DEPLOYMENT"
                ],
                "type": "string"
              }
            },
            "required": [
              "type",
              "target",
              "params"
            ],
            "type": "object"
          }
        ]
      },
      "ActionType": {
        "enum": [
          "ACKNOWLEDGE",
          "VIEW_LOGS",
          "RESTART_DEPLOYMENT",
          "SCALE_DEPLOYMENT"
        ],
        "type": "string"
      },
      "CreateSessionBody": {
        "properties": {
          "scenarioId": {
            "example": "orders-down",
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "scenarioId"
        ],
        "type": "object"
      },
      "CreateSessionResponse": {
        "properties": {
          "sessionId": {
            "example": "01JBQ4ZJ8V2N7K3M5P6R8S9T0W",
            "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
            "type": "string"
          }
        },
        "required": [
          "sessionId"
        ],
        "type": "object"
      },
      "DashboardSnapshot": {
        "properties": {
          "availableActions": {
            "items": {
              "$ref": "#/components/schemas/ActionType"
            },
            "type": "array"
          },
          "elapsedSeconds": {
            "minimum": 0,
            "type": "integer"
          },
          "generatedAt": {
            "example": "2026-11-05T18:04:12.000Z",
            "format": "date-time",
            "type": "string"
          },
          "recentEvents": {
            "items": {
              "$ref": "#/components/schemas/RecentEvent"
            },
            "maxItems": 20,
            "type": "array"
          },
          "services": {
            "items": {
              "$ref": "#/components/schemas/ServiceView"
            },
            "type": "array"
          },
          "sessionId": {
            "example": "01JBQ4ZJ8V2N7K3M5P6R8S9T0W",
            "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
            "type": "string"
          },
          "stale": {
            "type": "boolean"
          },
          "state": {
            "$ref": "#/components/schemas/SessionState"
          }
        },
        "required": [
          "sessionId",
          "state",
          "generatedAt",
          "elapsedSeconds",
          "services",
          "recentEvents",
          "availableActions"
        ],
        "type": "object"
      },
      "ErrorBody": {
        "properties": {
          "error": {
            "properties": {
              "code": {
                "$ref": "#/components/schemas/ErrorCode"
              },
              "details": {
                "additionalProperties": {},
                "type": "object"
              },
              "message": {
                "type": "string"
              },
              "requestId": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message",
              "requestId"
            ],
            "type": "object"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "ErrorCode": {
        "enum": [
          "VALIDATION_ERROR",
          "MALFORMED_JSON",
          "UNAUTHORIZED",
          "NOT_FOUND",
          "SESSION_BUSY",
          "SESSION_NOT_ACTIVE",
          "PAYLOAD_TOO_LARGE",
          "UNSUPPORTED_MEDIA_TYPE",
          "ACTION_NOT_ALLOWED",
          "INTERNAL",
          "UNAVAILABLE",
          "NOT_READY",
          "STATS_TIMEOUT"
        ],
        "type": "string"
      },
      "EventType": {
        "enum": [
          "SESSION_STARTED",
          "FAULT_INJECTED",
          "ACKNOWLEDGED",
          "ACTION",
          "VIEW_LOGS",
          "RESOLVED",
          "FAILED",
          "SCORED"
        ],
        "type": "string"
      },
      "FailureReason": {
        "enum": [
          "TIMEOUT",
          "ABANDONED",
          "ERROR"
        ],
        "type": "string"
      },
      "PodView": {
        "properties": {
          "ageSeconds": {
            "minimum": 0,
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "phase": {
            "example": "Running",
            "type": "string"
          },
          "ready": {
            "type": "boolean"
          },
          "restarts": {
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "name",
          "phase",
          "ready",
          "restarts",
          "ageSeconds"
        ],
        "type": "object"
      },
      "RecentEvent": {
        "properties": {
          "summary": {
            "type": "string"
          },
          "ts": {
            "example": "2026-11-05T18:04:12.000Z",
            "format": "date-time",
            "type": "string"
          },
          "type": {
            "$ref": "#/components/schemas/EventType"
          }
        },
        "required": [
          "ts",
          "type",
          "summary"
        ],
        "type": "object"
      },
      "ScenarioPublic": {
        "properties": {
          "availableActions": {
            "items": {
              "$ref": "#/components/schemas/ActionType"
            },
            "type": "array"
          },
          "description": {
            "type": "string"
          },
          "id": {
            "example": "orders-down",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "type": "string"
          },
          "maxResolveSeconds": {
            "type": "integer"
          },
          "scoring": {
            "$ref": "#/components/schemas/ScenarioScoring"
          },
          "targets": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "title": {
            "type": "string"
          },
          "warmupSeconds": {
            "type": "integer"
          }
        },
        "required": [
          "id",
          "title",
          "description",
          "warmupSeconds",
          "maxResolveSeconds",
          "targets",
          "availableActions",
          "scoring"
        ],
        "type": "object"
      },
      "ScenarioScoring": {
        "properties": {
          "base": {
            "minimum": 0,
            "type": "number"
          },
          "perSecondTTD": {
            "minimum": 0,
            "type": "number"
          },
          "perSecondTTR": {
            "minimum": 0,
            "type": "number"
          },
          "perWrongAction": {
            "minimum": 0,
            "type": "number"
          }
        },
        "required": [
          "base",
          "perSecondTTD",
          "perSecondTTR",
          "perWrongAction"
        ],
        "type": "object"
      },
      "ScenarioSummary": {
        "properties": {
          "description": {
            "type": "string"
          },
          "id": {
            "example": "orders-down",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "type": "string"
          },
          "maxResolveSeconds": {
            "type": "integer"
          },
          "title": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "description",
          "maxResolveSeconds"
        ],
        "type": "object"
      },
      "ServiceHealth": {
        "enum": [
          "healthy",
          "degraded",
          "down"
        ],
        "type": "string"
      },
      "ServiceView": {
        "properties": {
          "desiredReplicas": {
            "minimum": 0,
            "type": "integer"
          },
          "health": {
            "$ref": "#/components/schemas/ServiceHealth"
          },
          "latencyMs": {
            "minimum": 0,
            "type": "integer"
          },
          "name": {
            "example": "orders",
            "type": "string"
          },
          "pods": {
            "items": {
              "$ref": "#/components/schemas/PodView"
            },
            "type": "array"
          },
          "readyReplicas": {
            "minimum": 0,
