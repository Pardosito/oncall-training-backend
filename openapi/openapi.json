      },
      "SessionView": {
        "properties": {
          "acknowledgedAt": {
            "example": "2026-11-05T18:04:12.000Z",
            "format": "date-time",
            "type": "string"
          },
          "actionsCount": {
            "type": "integer"
          },
          "createdAt": {
            "example": "2026-11-05T18:04:12.000Z",
            "format": "date-time",
            "type": "string"
          },
          "endedAt": {
            "example": "2026-11-05T18:04:12.000Z",
            "format": "date-time",
            "type": "string"
          },
          "failureReason": {
            "$ref": "#/components/schemas/FailureReason"
          },
          "faultInjectedAt": {
            "example": "2026-11-05T18:04:12.000Z",
            "format": "date-time",
            "type": "string"
          },
          "scenarioId": {
            "type": "string"
          },
          "score": {
            "type": "number"
          },
          "sessionId": {
            "example": "01JBQ4ZJ8V2N7K3M5P6R8S9T0W",
            "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
            "type": "string"
          },
          "state": {
            "$ref": "#/components/schemas/SessionState"
          },
          "ttdSeconds": {
            "type": "integer"
          },
          "ttrSeconds": {
            "type": "integer"
          },
          "wrongActions": {
            "type": "integer"
          }
        },
        "required": [
          "sessionId",
          "scenarioId",
          "state",
          "createdAt"
        ],
        "type": "object"
      }
