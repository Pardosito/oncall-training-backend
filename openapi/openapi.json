      "post": {
        "description": "The worker applies actions in order; the effect shows up in the dashboard once observed (no optimistic updates).",
        "parameters": [
          {
            "in": "path",
            "name": "sessionId",
            "required": true,
            "schema": {
              "example": "01JBQ4ZJ8V2N7K3M5P6R8S9T0W",
